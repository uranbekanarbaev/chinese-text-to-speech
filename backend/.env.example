# Copy this file to .env and fill in your own values.
# Nothing below is a real credential — every value here is a placeholder.

# --- Database (shared infra_db, ctts schema/role — see postgres-database repo) ---
DATABASE_URL=postgresql+asyncpg://ctts_user:change-me@infra_db:5432/postgres
DATABASE_SCHEMA=ctts

# --- Auth ---
# MUST be the exact same value hsk-tutor's backend used to sign existing
# ctts.* JWTs, or every currently-signed-in user gets logged out on cutover.
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256

# --- Tencent Cloud (TTS fallback + ASR) ---
TENCENT_SECRET_ID=your-tencent-secret-id
TENCENT_SECRET_KEY=your-tencent-secret-key
TENCENT_REGION=ap-singapore

# --- iFLYTEK (TTS primary) ---
IFLYTEK_APPID=
IFLYTEK_API_KEY=
IFLYTEK_API_SECRET=

# --- Google OAuth ---
# redirect_uri registered in Google Cloud Console must match API_URL below
# exactly (…/api/ctts/auth/google/callback) or the OAuth flow fails.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CTTS_FRONTEND_URL=https://uranbekanarbaev.dev
API_URL=https://api-chinese-tts.hsk-tutor.com

# --- CORS ---
CORS_ORIGINS=*

# --- Analytics ---
AMPLITUDE_API_KEY=

# --- Object storage (Alibaba OSS, audio cache) ---
ALIBABA_ACCESS_KEY_ID=
ALIBABA_ACCESS_KEY_SECRET=
ALIBABA_OSS_ENDPOINT=oss-ap-southeast-1.aliyuncs.com
ALIBABA_BUCKET_NAME=your-bucket-name
